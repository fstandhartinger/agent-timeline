[Unit]
Description=Agent Timeline read-only API
After=network.target agent-timeline-collector.service

[Service]
Type=simple
WorkingDirectory=%h/Dev/agent-timeline
EnvironmentFile=%h/.config/agent-timeline-web.env
Environment=AGENT_TIMELINE_DB=%h/.local/share/agent-timeline/agents.sqlite3
Environment=AGENT_TIMELINE_HOST=127.0.0.1
Environment=AGENT_TIMELINE_PORT=8890
ExecStart=/usr/bin/python3 %h/Dev/agent-timeline/server.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=%h/Dev/agent-timeline %h/.local/share/agent-timeline
MemoryMax=512M
RuntimeMaxSec=infinity

[Install]
WantedBy=default.target
